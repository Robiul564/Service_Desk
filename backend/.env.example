# Copy to backend/.env and adjust. Every value has a sensible default.
DATABASE_URL=sqlite:///./data/service_requests.db
SECRET_KEY=change-me-before-deploying
TOKEN_TTL_MINUTES=480

# Background processing
WORKER_COUNT=4
STEP_DELAY_SECONDS=2.0
TICKS_PER_STEP=3
FAILURE_RATE=0.08

# Misc
SEED_DEMO_USERS=true
LOG_LEVEL=INFO
CORS_ORIGINS=
